# Generic operating system and IDE files
.DS_Store
.vscode/
.idea/
.claude/*
!.claude/hooks/
!.claude/settings.json
.*mcp*
*.original.md

# Common package manager directories
node_modules/
vendor/

# Environment files
.env
.env.local

# Secrets and keys (override global gitignore - all secrets here are SOPS-encrypted)
!secret.yaml
!*-secret.yaml
!*-secrets.yaml
*.agekey
age.agekey*
*.key
*.crt
*.pem
*.p12
*.pfx
*.csr

# Build artifacts
*.log
*.swp
build/
dist/
target/


# Backup directory with secrets
.backup/secrets/
.backup/secrets/*.json
.backup/secrets/*.txt
.backup/secrets/*.agekey
.backup/ENV_VARS.md
.monitoring/
