[Unit]
Description=Node maintenance — Phase 1 (CP self-update)
ConditionPathExists=!/var/lib/node-maintenance/phase2-pending
Wants=network-online.target
After=network-online.target k3s.service
Documentation=https://github.com/AKhozya/homelab/tree/main/node-maintenance

[Service]
Type=oneshot
User=root
WorkingDirectory=/etc/node-maintenance/ansible
ExecStartPre=/bin/sh -c 'install -d -m 0750 -o root -g adm /var/log/node-maintenance; echo "ANSIBLE_LOG_PATH=/var/log/node-maintenance/phase1-$(date -u +%%d-%%m-%%Y).log" > /run/node-maintenance.env'
EnvironmentFile=-/run/node-maintenance.env
# Serialized via node-maintenance-lock (wait mode): the reboot MUST run, so wait out any in-progress
# drift-heal (up to 15min) rather than skip — guarantees no heal runs concurrently with the reboot.
#
# Three steps, each under the lock; a failure stops the rest and skips the reboot:
#   1. the playbook's preflight tasks alone (tag preflight): no active backup, disk space, Flux
#      Ready, physical workers reachable. If any fails, nothing is upgraded.
#   2. the full repo upgrade, outside any ansible process, so python and ansible upgrade
#      together. An ansible-core upgrade under a running play makes copy/template tasks load
#      action plugins from the new core while ConfigManager stays on the old import (TypeError
#      on `templar=`, seen on 2.20.5 → 2.21.0). A python upgrade under a running play removes
#      the stdlib the play still imports. Rejected: `pacman -Sy ansible ansible-core` alone, a
#      partial upgrade.
#   3. the whole playbook, preflight included, so a backup that started during step 2 still
#      blocks the reboot. If that second preflight fails, the CP stays upgraded but not
#      rebooted; kernel-modules-hook keeps the running kernel's modules loadable until the
#      next reboot.
ExecStart=/usr/local/sbin/node-maintenance-lock.sh wait -- /usr/bin/ansible-playbook -i inventory.yml phase1.yml --tags preflight
ExecStart=/usr/local/sbin/node-maintenance-lock.sh wait -- /usr/bin/pacman -Syu --noconfirm
ExecStart=/usr/local/sbin/node-maintenance-lock.sh wait -- /usr/bin/ansible-playbook -i inventory.yml phase1.yml
ExecStartPost=/bin/sh -c 'systemctl reboot'
ExecStopPost=/bin/sh -c '[ "$SERVICE_RESULT" != "success" ] && /usr/local/sbin/telegram-notify.sh "❌ node-maintenance phase1 failed (result=$SERVICE_RESULT exit=$EXIT_STATUS). No reboot. Log: /var/log/node-maintenance/phase1-$(date -u +%%d-%%m-%%Y).log" || true'
TimeoutStartSec=30min
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
