[Unit]
Description=node-config drift-heal (ansible) — 2x/day
Documentation=https://github.com/AKhozya/homelab/tree/main/node-maintenance

[Timer]
OnCalendar=*-*-* 03:00:00 UTC
OnCalendar=*-*-* 15:00:00 UTC
RandomizedDelaySec=300
Persistent=true
Unit=node-maintenance-config.service

[Install]
WantedBy=timers.target
