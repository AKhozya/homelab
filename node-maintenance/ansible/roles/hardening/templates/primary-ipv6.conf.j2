# Managed by node-maintenance (hardening role). Plan: docs/runbooks/ipv6-enablement.md
[IPv6AcceptRA]
# No IPv6 default route: no node needs IPv6 to the internet, and pods have no IPv6 at all.
UseGateway=no
# Any LAN device can send a router advert. If one sets the "managed" or "other" flag, networkd starts
# DHCPv6 by default and takes the DNS servers that any DHCPv6 server offers, plus an address if the
# flag is "managed". No node uses DHCPv6.
DHCPv6Client=no
# A router advert can also carry routes, including ::/0, and a router can send redirects. No node
# needs either.
UseRoutePrefix=no
UseRedirect=no
{% if ipv6_ra_accept_addresses | bool %}
# Private prefixes only (fc00::/7 covers every ULA), each with the fixed suffix from ipv6_token,
# so the eero's IPv6 DNS field can name the Blocky fallback. The ISP's prefix gives no address.
# The on-link route stays: networkd adds the address without a prefix route, so the fallback
# reaches its LAN clients through the on-link route.
PrefixAllowList=fc00::/7
Token={{ ipv6_token }}
{% else %}
# No SLAAC address at all. A global address built from the MAC would expose the MAC, and the
# internet could reach it if the eero's inbound block failed.
UseAutonomousPrefix=no
# If a node has no address on a prefix, the prefix's on-link route serves no purpose.
UseOnLinkPrefix=no
{% endif %}
