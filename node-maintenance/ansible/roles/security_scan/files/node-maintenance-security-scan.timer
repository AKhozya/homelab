[Unit]
Description=Node maintenance — monthly security scan trigger
Documentation=https://github.com/AKhozya/homelab/tree/main/node-maintenance

[Timer]
# Persistent=false never writes the stamp under /var/lib/systemd/timers/, so
# each node's stamp stays at its July 2026 date. If you set Persistent=true,
# first remove the stamp on each node or set it to now; otherwise the next
# restart of this timer (the weekly reboot is one) starts a catch-up scan
# within the RandomizedDelaySec hour. The cost of false: if a node is down at
# 04:00 on the 1st, it skips that month's scan. If the 1st is a Saturday, the
# 04:00-05:00 window overlaps the Sat 04:30 UTC reboot; if a node reboots
# before its random start, it skips that month too.
OnCalendar=*-*-01 04:00:00 UTC
Persistent=false
RandomizedDelaySec=3600
Unit=node-maintenance-security-scan.service

[Install]
WantedBy=timers.target
