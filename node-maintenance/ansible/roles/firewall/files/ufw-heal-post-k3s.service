[Unit]
Description=Heal UFW after K3s + fail2ban fully populate ip6tables chains
Documentation=https://bugs.launchpad.net/ufw/+bug/1987227
# k3s-wait-ready.service is the readiness barrier (oneshot, RemainAfterExit=yes). If it did
# not complete, /run/k3s-ready is absent and this unit skips.
After=k3s-wait-ready.service ufw.service fail2ban.service network-online.target
Wants=k3s-wait-ready.service ufw.service
ConditionPathExists=/usr/sbin/ufw
ConditionPathExists=/usr/local/sbin/ufw-heal-post-k3s.sh
ConditionPathExists=/run/k3s-ready

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/ufw-heal-post-k3s.sh
TimeoutStartSec=5min
RemainAfterExit=no
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
