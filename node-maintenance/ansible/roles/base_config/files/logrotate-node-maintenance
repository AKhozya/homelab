# Node maintenance phase1/phase2 + config drift-heal ansible logs (CP only).
# phase1/phase2 names include DD-MM-YYYY, so a same-day re-run appends (hence maxsize).
# Drift-heal writes config-latest.log and truncates it on each run. Its per-run copies sit in
# config-archive/, which this glob does not reach; node-maintenance-config.service keeps the 50 newest.
/var/log/node-maintenance/phase1-*.log /var/log/node-maintenance/phase2-*.log /var/log/node-maintenance/config-*.log {
    weekly
    rotate 8
    maxsize 10M
    compress
    delaycompress
    missingok
    notifempty
    create 0640 root adm
}
