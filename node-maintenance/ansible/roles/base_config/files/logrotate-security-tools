# Full per-tool logs (lynis overwrites each run; rkhunter appends each run).
# Retention: 6 months — older rotations compressed + pruned.
/var/log/lynis.log /var/log/rkhunter.log {
    monthly
    rotate 6
    compress
    delaycompress
    missingok
    notifempty
    create 0640 root root
}

# Monthly scan summaries (one file per YYYY-MM, written by node-maintenance-security-scan.timer).
# Each month writes a new file, so `rotate` never removes an old month; security-scan.sh
# deletes summaries older than 400 days itself.
/var/log/node-maintenance/security-scan-*.log {
    monthly
    rotate 12
    compress
    delaycompress
    missingok
    notifempty
    create 0640 root adm
}
