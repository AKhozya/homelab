[Unit]
Description=Node config drift-heal (ansible node-config.yml)
Documentation=file:///etc/node-maintenance/README.md
After=network-online.target node-maintenance-kubectl-proxy.service
Wants=network-online.target
# Skip drift-heal during weekly maintenance window. Phase1 sets the flag
# before reboot; phase2 clears it after successful worker rollout. Drift-
# heal targets workers via SSH, which fails when phase2 is mid-reboot.
#
# ExecCondition replaces static ConditionPathExists (2026-05-16):
#   - Flag absent → proceed
#   - Flag < 2h old → skip (maintenance in progress)
#   - Flag >= 2h + Flux healthy → auto-clear + Telegram warn + proceed
#   - Flag >= 2h + Flux unhealthy → skip (needs investigation)
# Prevents stale flag from blocking drift-heal all day after transient
# phase2 failure (e.g. Flux source-controller SSH timeout post-reboot).
#
# Second ExecCondition (2026-05-22): skip if pacman is mid-transaction.
# Concurrent `pacman -Syu` (manual or otherwise) that upgrades ansible-core
# mid-run causes a fatal in-memory/on-disk mismatch — action plugins reload
# from the new core (e.g. copy.py passing templar=) while ConfigManager
# stays on the old import → TypeError. Skipping is safe; next timer cycle
# (10min) catches up after pacman releases the DB lock.

[Service]
Type=oneshot
User=root
WorkingDirectory=/etc/node-maintenance/ansible
Environment=ANSIBLE_CONFIG=/etc/node-maintenance/ansible/ansible.cfg
ExecCondition=/usr/local/sbin/check-phase2-flag-age.sh
ExecCondition=/bin/sh -c '[ ! -e /var/lib/pacman/db.lck ]'
ExecStartPre=/bin/sh -c 'install -d -m 0750 -o root -g adm /var/log/node-maintenance /var/log/node-maintenance/config-archive && echo "=== start: $(date -u -Iseconds) ===" > /var/log/node-maintenance/config-latest.log'
# Serialized via node-maintenance-lock (skip mode): if another heal/sync/reboot holds the lock,
# skip this run (exit 0) instead of overlapping. Two concurrent ansible heals raced before — the
# 10-min sync re-triggers this ~9-min heal, and the config timer + sync could overlap (2026-05-25).
ExecStart=/usr/local/sbin/node-maintenance-lock.sh skip -- /usr/bin/ansible-playbook -D /etc/node-maintenance/ansible/node-config.yml -i /etc/node-maintenance/ansible/inventory.yml
# Archive each run's log, keep the 50 most recent. config-latest.log on its own is
# overwritten every run, so a per-node claim cannot be checked after the fact.
ExecStopPost=/bin/sh -c 'cp -f /var/log/node-maintenance/config-latest.log /var/log/node-maintenance/config-archive/config-$(date -u +%%Y%%m%%dT%%H%%M%%SZ).log 2>/dev/null; ls -1t /var/log/node-maintenance/config-archive/config-*.log 2>/dev/null | tail -n +51 | xargs -r rm -f --'
ExecStopPost=/usr/local/sbin/node-maintenance-config-notify.sh ${SERVICE_RESULT}
StandardOutput=append:/var/log/node-maintenance/config-latest.log
StandardError=append:/var/log/node-maintenance/config-latest.log
TimeoutStartSec=15min
Nice=15
IOSchedulingClass=idle

[Install]
WantedBy=multi-user.target
