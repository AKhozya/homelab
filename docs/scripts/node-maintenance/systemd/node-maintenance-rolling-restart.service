[Unit]
Description=Rolling restart of k3s/k3s-agent (serial, lease-config apply)
Documentation=file:///etc/node-maintenance/README.md
After=network-online.target
Wants=network-online.target
# Skip during weekly maintenance — phase1/phase2 own the reboot+rollout
# window. Rolling-restart triggered mid-phase2 would race with worker
# reboot loop. Same guard as config.service.
ConditionPathExists=!/var/lib/node-maintenance/phase2-pending

[Service]
Type=oneshot
User=root
WorkingDirectory=/etc/node-maintenance/ansible
Environment=ANSIBLE_CONFIG=/etc/node-maintenance/ansible/ansible.cfg
ExecStartPre=/bin/sh -c 'install -d -m 0750 -o root -g adm /var/log/node-maintenance /var/log/node-maintenance/rolling-restart-archive && echo "=== start: $(date -u -Iseconds) ===" > /var/log/node-maintenance/rolling-restart-latest.log'
ExecStart=/usr/bin/ansible-playbook /etc/node-maintenance/ansible/rolling-restart-k3s.yml -i /etc/node-maintenance/ansible/inventory.yml
# Archive each run + retain 30 most recent (less frequent than config — operator-triggered).
ExecStopPost=/bin/sh -c 'cp -f /var/log/node-maintenance/rolling-restart-latest.log /var/log/node-maintenance/rolling-restart-archive/rolling-restart-$(date -u +%%Y%%m%%dT%%H%%M%%SZ).log 2>/dev/null; ls -1t /var/log/node-maintenance/rolling-restart-archive/rolling-restart-*.log 2>/dev/null | tail -n +31 | xargs -r rm -f --'
ExecStopPost=/bin/sh -c '[ "$SERVICE_RESULT" != "success" ] && /usr/local/sbin/telegram-notify.sh "❌ node-maintenance-rolling-restart failed (result=$SERVICE_RESULT exit=$EXIT_STATUS). Log: journalctl -u node-maintenance-rolling-restart.service -n 80" || true'
StandardOutput=append:/var/log/node-maintenance/rolling-restart-latest.log
StandardError=append:/var/log/node-maintenance/rolling-restart-latest.log
# CP restart + 3× (restart + Ready + verify + 30s pause) ≈ 5-7min real time.
# 15min cap matches config.service.
TimeoutStartSec=15min
Nice=10

[Install]
WantedBy=multi-user.target
