[Unit]
Description=Node maintenance — git sync + install.sh --sync-only
Documentation=file:///etc/node-maintenance/README.md
After=network-online.target
Wants=network-online.target
# Skip while phase1/phase2 weekly maintenance is in flight — sync auto-runs
# config.service on git change, and config touches workers via SSH which
# fails when phase2 is mid-reboot. Flag set by phase1, cleared by phase2.
ConditionPathExists=!/var/lib/node-maintenance/phase2-pending

[Service]
Type=oneshot
User=root
ExecStart=/usr/local/sbin/node-maintenance-sync-from-git.sh
ExecStopPost=/bin/sh -c '[ "$SERVICE_RESULT" != "success" ] && /usr/local/sbin/telegram-notify.sh "❌ node-maintenance-sync failed (result=$SERVICE_RESULT exit=$EXIT_STATUS). Log: journalctl -u node-maintenance-sync.service -n 50" || true'
TimeoutStartSec=20min
Nice=15
IOSchedulingClass=idle

[Install]
WantedBy=multi-user.target
