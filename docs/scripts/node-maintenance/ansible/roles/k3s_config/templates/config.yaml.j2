{% set is_cp = inventory_hostname in groups['control_plane'] -%}
# K3s {{ 'Control Plane' if is_cp else 'Worker' }} Configuration
# Deployed by ansible roles/k3s_config — drift-healed daily by node-maintenance-config.timer.
# Edit group_vars/control_plane.yml, group_vars/workers.yml, or host_vars/*.yml to change.
# Applies on next K3s restart (no auto-restart — manual control over API/pod disruption).
{% if is_cp and k3s_default_storage_path is defined %}

default-local-storage-path: {{ k3s_default_storage_path }}
{% endif %}
{% if k3s_data_dir is defined %}

# Per-host K3s data-dir override (containerd, images, state)
data-dir: {{ k3s_data_dir }}
{% endif %}
{% if is_cp and k3s_disable_helm_controller | default(false) %}

# Disable Helm controller (Flux manages everything)
disable-helm-controller: true
{% endif %}
{% if is_cp and k3s_disable is defined and k3s_disable | length > 0 %}

# Disable K3s bundled components (managed externally)
disable:
{% for item in k3s_disable %}
  - {{ item }}
{% endfor %}
{% endif %}

node-name: {{ inventory_hostname }}
node-ip: {{ node_ip }}
{% if k3s_node_taints is defined and k3s_node_taints | length > 0 %}

# Registration-time taints (k3s applies node-taint only when the node first joins)
node-taint:
{% for t in k3s_node_taints %}
  - "{{ t }}"
{% endfor %}
{% endif %}

{% if k3s_node_labels is defined and k3s_node_labels | length > 0 %}

node-label:
{% for l in k3s_node_labels %}
  - "{{ l }}"
{% endfor %}
{% endif %}

kubelet-arg:
  - "config=/etc/rancher/k3s/kubelet.yaml"
{% if k3s_prefer_bundled_bin | default(false) %}

# Use k3s's BUNDLED iptables/nft binaries instead of the host's xtables-nft. The host iptables
# v1.8.13 (nft backend) with mixed nft_compat + legacy ip_tables modules hits stale-chain
# "CHAIN_USER_ADD/RULE_APPEND File exists" on reboot, so kube-proxy's atomic iptables-restore
# fails and KUBE-SERVICES (10.43.0.1 DNAT) never gets programmed → ClusterIP wedged until a
# k3s restart. Bundled bins avoid that conflict. See HOMELAB_HISTORY, 2026-05-25.
prefer-bundled-bin: true
{% endif %}
{% if is_cp %}

# Controller-manager flags (CP only).
# - terminated-pod-gc-threshold: Default 12500 too high for homelab —
#   eviction leftovers linger after reboots. 20 allows ~10 normal Job pods + headroom.
# - node-monitor-grace-period: lockstep with kubelet nodeLeaseDurationSeconds (60s).
#   CM marks node Unknown when (now > lease.renewTime + grace). Must be >= lease + 1
#   renewal interval (60 + 15 = 75s minimum). Default 50s would override the lease bump.
# - node-monitor-period: how often CM checks lease state. Default 5s, kept explicit.
kube-controller-manager-arg:
{% if k3s_terminated_pod_gc_threshold is defined %}
  - "terminated-pod-gc-threshold={{ k3s_terminated_pod_gc_threshold }}"
{% endif %}
  - "node-monitor-period={{ k3s_node_monitor_period | default('5s') }}"
  - "node-monitor-grace-period={{ k3s_node_monitor_grace_period | default('75s') }}"
{% endif %}
{% if is_cp and k3s_secrets_encryption | default(false) %}

# Secrets encrypted at rest (AES-CBC). Enable flow:
#   k3s secrets-encrypt enable → restart → rotate-keys → restart → verify `status`.
secrets-encryption: true
{% endif %}
{% if is_cp and k3s_tls_san is defined and k3s_tls_san | length > 0 %}

# Additional API-server cert SANs. Drift here = template change → telegram alert.
# Restart K3s to regenerate cert: sudo systemctl restart k3s
tls-san:
{% for s in k3s_tls_san %}
  - "{{ s }}"
{% endfor %}
{% endif %}
