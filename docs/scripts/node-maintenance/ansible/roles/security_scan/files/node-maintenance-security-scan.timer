[Unit]
Description=Node maintenance — monthly security scan trigger
Documentation=file:///etc/node-maintenance/README.md

[Timer]
# TEMPORARY (August 2026): shifted 1st → 8th. Revert OnCalendar to *-*-01 and
# Persistent to true together after 2026-08-08.
# Persistent=false while shifted — the on-disk stamp still reads the 2026-07-01
# run, so a persistent timer can treat the 2026-07-08 occurrence as missed and
# fire immediately on daemon-reload instead of waiting for the 8th.
OnCalendar=*-*-08 04:00:00 UTC
Persistent=false
RandomizedDelaySec=3600
Unit=node-maintenance-security-scan.service

[Install]
WantedBy=timers.target
