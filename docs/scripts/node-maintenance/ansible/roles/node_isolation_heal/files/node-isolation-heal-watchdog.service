[Unit]
Description=Node isolation heal watchdog (worker CP-isolation self-recovery)
Documentation=https://github.com/AKhozya/homelab
# Defense-in-depth: role is workers-only (node-config.yml Play 4), but also gate on the
# heal script existing. The script itself no-ops where the k3s-agent unit is absent (CP).
ConditionPathExists=/usr/local/sbin/node-isolation-heal.sh

[Service]
Type=oneshot
# "-" = optional; missing env just uses the script's built-in safe defaults (dry-run on).
EnvironmentFile=-/etc/node-isolation-heal/env
ExecStart=/usr/local/sbin/node-isolation-heal.sh
# Two curl probes (@5s) + a tcp probe (@5s) + a possible k3s-agent restart fit well under
# this. A oneshot won't double-fire while still running, so a >interval run can't pile up.
TimeoutStartSec=3min
StandardOutput=journal
StandardError=journal
