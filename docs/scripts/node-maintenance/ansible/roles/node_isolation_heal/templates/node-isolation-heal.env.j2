# Managed by ansible (node_isolation_heal role) — do not edit by hand.
NIH_DRY_RUN={{ 1 if node_isolation_dry_run else 0 }}
NIH_NODE_INDEX={{ node_isolation_reboot_index | int }}
NIH_FAIL_CONSECUTIVE={{ node_isolation_fail_consecutive | int }}
NIH_RESTART_AFTER_S={{ node_isolation_restart_after_s | int }}
NIH_REBOOT_BASE_S={{ node_isolation_reboot_base_s | int }}
NIH_REBOOT_STAGGER_S={{ node_isolation_reboot_stagger_s | int }}
NIH_MIN_UPTIME_S={{ node_isolation_min_uptime_s | int }}
NIH_REBOOT_GAP_S={{ node_isolation_reboot_gap_s | int }}
NIH_RESTART_COOLDOWN_S={{ node_isolation_restart_cooldown_s | int }}
NIH_CURL_TIMEOUT={{ node_isolation_curl_timeout | int }}
# IPs, never hostnames: Blocky DNS runs inside the cluster, so name resolution is unavailable
# in exactly the outage this probe has to survive.
{# difference uses a set operation. If sort is omitted, peer order can change between runs
   and drift-heal rewrites this file. Order does not affect the veto: probe_peers() returns
   on the first peer that answers. #}
NIH_PEER_HOSTS={{ groups['workers'] | difference([inventory_hostname]) | map('extract', hostvars, 'ansible_host') | sort | join(' ') }}
NIH_PEER_PORT={{ node_isolation_peer_port | int }}
NIH_MAINT_HOLD_MAX_AGE_S={{ node_isolation_maint_hold_max_age_s | int }}
