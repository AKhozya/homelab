---
# ansible-lint config for node-maintenance playbooks

exclude_paths:
  - .git
  - .github

skip_list:
  - yaml[line-length]          # long alertname regex + URLs in tg_message deliberate
  - command-instead-of-shell   # yay_cmd needs shell expansion (sudo -u ... yay -Syu ...)

# Declare collections explicitly — avoids false "unknown module" for kubernetes.core
# when ansible-lint runs in isolated env. Requires `ansible-galaxy collection install`
# to have been run with the user's ANSIBLE_COLLECTIONS_PATH.
