{
    "additional-repositories": [],
    "archinstall-language": "English",
    "audio_config": null,
    "bootloader": "systemd-bootctl",
    "config_version": "2.8.0",
    "debug": false,
    "hostname": "worker-node-2",
    "kernels": ["linux"],
    "locale_config": {
        "kb_layout": "us",
        "sys_enc": "UTF-8",
        "sys_lang": "en_US"
    },
    "mirror_config": {
        "custom_mirrors": [],
        "mirror_regions": {
            "United Kingdom": [
                "https://www.mirrorservice.org/sites/ftp.archlinux.org/$repo/os/$arch",
                "https://mirror.bytemark.co.uk/archlinux/$repo/os/$arch"
            ]
        }
    },
    "network_config": {
        "type": "nm"
    },
    "no_pkg_lookups": false,
    "ntp": true,
    "offline": false,
    "packages": [
        "base-devel",
        "bash-completion",
        "btop",
        "efibootmgr",
        "fail2ban",
        "fd",
        "fzf",
        "git",
        "lvm2",
        "openssh",
        "rsync",
        "tree",
        "ufw",
        "vim"
    ],
    "parallel downloads": 5,
    "profile_config": {
        "gfx_driver": null,
        "greeter": null,
        "profile": {
            "custom_settings": {},
            "details": [],
            "main": "Server"
        }
    },
    "script": "guided",
    "silent": false,
    "swap": false,
    "timezone": "Europe/London",
    "uki": false,
    "version": "2.8.0"
}
