{
  "permissions": {
    "allow": [
      "Bash(chezmoi data *)",
      "Bash(chezmoi diff *)",
      "Bash(chezmoi managed *)",
      "Bash(chezmoi status *)",
      "Bash(flux events *)",
      "Bash(flux get *)",
      "Bash(flux logs *)",
      "Bash(flux reconcile *)",
      "Bash(flux resume *)",
      "Bash(flux suspend *)",
      "Bash(flux tree *)",
      "Bash(kubectl apply --dry-run=server *)",
      "Bash(kubectl delete pod *)",
      "Bash(kubectl describe *)",
      "Bash(kubectl get *)",
      "Bash(kubectl logs *)",
      "Bash(kubectl rollout restart *)",
      "Bash(kubectl rollout status *)",
      "Bash(kustomize build *)",
      "Bash(shellcheck *)",
      "Bash(yamllint *)",
      "mcp__plugin_ecc_exa__web_search_exa"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/homelab-analysis-reminder.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/cavecrew-reviewer-pre-push.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/worktree-guard.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/worktree-session-start.sh"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "andrej-karpathy-skills@karpathy-skills": true
  }
}
