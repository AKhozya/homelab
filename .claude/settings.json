{
  "permissions": {
    "allow": [
      "Bash(chezmoi data *)",
      "Bash(chezmoi diff *)",
      "Bash(chezmoi managed *)",
      "Bash(chezmoi status *)",
      "Bash(flux events *)",
      "Bash(flux get *)",
      "Bash(flux logs *)",
      "Bash(flux reconcile *)",
      "Bash(flux resume *)",
      "Bash(flux suspend *)",
      "Bash(flux tree *)",
      "Bash(bash ~/.agents/skills/*)",
      "Bash(bash ~/.claude/skills/*)",
      "Bash(dyff between *)",
      "Bash(helm history *)",
      "Bash(helm list *)",
      "Bash(helm status *)",
      "Bash(kubeconform *)",
      "Bash(kubectl api-resources *)",
      "Bash(kubectl apply --dry-run=server *)",
      "Bash(kubectl auth can-i *)",
      "Bash(kubectl cluster-info *)",
      "Bash(kubectl create job *)",
      "Bash(kubectl delete pod *)",
      "Bash(kubectl describe *)",
      "Bash(kubectl diff *)",
      "Bash(kubectl events *)",
      "Bash(kubectl exec *)",
      "Bash(kubectl explain *)",
      "Bash(kubectl get *)",
      "Bash(kubectl logs *)",
      "Bash(kubectl port-forward *)",
      "Bash(kubectl rollout restart *)",
      "Bash(kubectl rollout status *)",
      "Bash(kubectl top *)",
      "Bash(kubectl version *)",
      "Bash(kubectl wait *)",
      "Bash(kustomize build *)",
      "Bash(shellcheck *)",
      "Bash(stern *)",
      "Bash(yamllint *)",
      "mcp__plugin_ecc_exa__web_search_exa"
    ],
    "deny": [
      "Bash(kubectl create job *--from=cronjob/backup-replication*)",
      "Bash(kubectl create job *--from=cronjob/immich-backup*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/homelab-analysis-reminder.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/worktree-guard.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/worktree-session-start.sh"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {}
}
