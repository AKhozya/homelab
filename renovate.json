{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "n8n via GitHub releases to filter pre-releases",
      "managerFilePatterns": ["/apps/base/n8n/deployment\\.yaml$/"],
      "matchStrings": ["image:\\s*n8nio/n8n:(?<currentValue>[^\\s]+)"],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "n8n-io/n8n",
      "extractVersionTemplate": "n8n@(?<version>.*)",
      "versioningTemplate": "semver-coerced"
    }
  ],
  "commitMessagePrefix": "chore(deps): ",
  "commitMessageAction": "update",
  "dependencyDashboard": true,
  "dependencyDashboardApproval": false,
  "kubernetes": {
    "managerFilePatterns": [
      "/\\.yaml$/"
    ]
  },
  "helm-values": {
    "managerFilePatterns": [
      "/\\.yaml$/"
    ]
  },
  "flux": {
    "managerFilePatterns": [
      "/\\.yaml$/"
    ]
  },
  "prConcurrentLimit": 10,
  "prHourlyLimit": 10,
  "packageRules": [
    {
      "description": "Group Flux updates",
      "groupName": "Flux",
      "matchPackageNames": [
        "/fluxcd/"
      ]
    },
    {
      "description": "Group Helm chart updates",
      "matchDatasources": [
        "helm"
      ],
      "groupName": "Helm charts"
    },
    {
      "description": "Group Prometheus stack updates",
      "groupName": "Monitoring stack",
      "matchPackageNames": [
        "/prometheus/",
        "/grafana/",
        "/alertmanager/",
        "/loki/"
      ]
    },
    {
      "description": "Group Traefik updates",
      "groupName": "Traefik",
      "matchPackageNames": [
        "/traefik/"
      ]
    },
    {
      "description": "Require review for minor and patch updates",
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "reviewers": [
        "AKhozya"
      ],
      "assignees": [
        "AKhozya"
      ]
    },
    {
      "description": "Pin digests for Helm charts and images",
      "matchDatasources": [
        "helm",
        "docker"
      ],
      "pinDigests": false
    },
    {
      "description": "Require review for major updates",
      "matchUpdateTypes": [
        "major"
      ],
      "reviewers": [
        "AKhozya"
      ],
      "assignees": [
        "AKhozya"
      ],
      "minimumReleaseAge": "3 days"
    },
    {
      "description": "Ignore MySQL backup image - manually updated with cluster",
      "matchPackageNames": ["mysql"],
      "matchFileNames": ["**/mysql-backup-cronjob.yaml"],
      "enabled": false
    },
    {
      "description": "Disable all managers for n8n - using custom GitHub releases manager",
      "matchPackageNames": ["n8nio/n8n"],
      "matchManagers": ["kubernetes", "flux", "kustomize"],
      "enabled": false
    }
  ],
  "timezone": "Europe/London",
  "schedule": [
    "at any time"
  ],
  "ignorePaths": [
    "docs/**",
    "README.md"
  ]
}
