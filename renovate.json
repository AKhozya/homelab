{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
    "commitMessagePrefix": "chore(deps): ",
    "commitMessageAction": "update",
  "dependencyDashboard": true,
  "kubernetes": {
    "fileMatch": [
      "\\.yaml$"
    ]
  },
  "helm-values": {
    "fileMatch": [
      "\\.yaml$"
    ]
  },
  "flux": {
    "fileMatch": [
      "\\.yaml$"
    ]
  },
  "prConcurrentLimit": 10,
  "prHourlyLimit": 10,
  "packageRules": [
      {
        "description": "Group Flux updates",
        "matchPackagePatterns": ["fluxcd"],
        "groupName": "Flux"
      },
      {
        "description": "Group Helm chart updates",
        "matchDatasources": ["helm"],
        "groupName": "Helm charts"
      },
      {
        "description": "Group Prometheus stack updates",
        "matchPackagePatterns": ["prometheus", "grafana", "alertmanager", "loki"],
        "groupName": "Monitoring stack"
      },
      {
        "description": "Group Traefik updates",
        "matchPackagePatterns": ["traefik"],
        "groupName": "Traefik"
      },
      {
        "description": "Auto-merge minor and patch updates",
        "matchUpdateTypes": ["minor", "patch"],
        "automerge": true,
        "automergeType": "branch"
      },
      {
        "description": "Pin digests for Helm charts and images",
        "matchDatasources": ["helm", "docker"],
        "pinDigests": false
      },
      {
        "description": "Require review for major updates",
        "matchUpdateTypes": ["major"],
        "reviewers": ["AKhozya"],
        "assignees": ["AKhozya"],
        "stabilityDays": 3
      }
  ],
  "timezone": "Europe/London",
  "schedule": [
    "at any time"
  ]
    ,
    "ignorePaths": [
      "docs/**",
      "README.md"
      ]
}