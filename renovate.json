{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "n8n via GitHub releases to filter pre-releases",
      "managerFilePatterns": ["/^apps\\/base\\/n8n\\/deployment\\.yaml$/"],
      "matchStrings": ["image:\\s*n8nio/n8n:(?<currentValue>[^\\s]+)"],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "n8n-io/n8n",
      "extractVersionTemplate": "n8n@(?<version>.*)",
      "versioningTemplate": "semver-coerced"
    }
  ],
  "commitMessagePrefix": "chore(deps): ",
  "commitMessageAction": "update",
  "dependencyDashboard": true,
  "dependencyDashboardApproval": false,
  "kubernetes": {
    "managerFilePatterns": [
      "/\\.yaml$/"
    ]
  },
  "helm-values": {
    "managerFilePatterns": [
      "/\\.yaml$/"
    ]
  },
  "flux": {
    "managerFilePatterns": [
      "/\\.yaml$/"
    ]
  },
  "prConcurrentLimit": 10,
  "prHourlyLimit": 10,
  "packageRules": [
    {
      "description": "Group Flux updates",
      "groupName": "Flux",
      "matchPackageNames": [
        "/fluxcd/"
      ]
    },
    {
      "description": "Group Helm chart updates",
      "matchDatasources": [
        "helm"
      ],
      "groupName": "Helm charts"
    },
    {
      "description": "Group Prometheus stack updates",
      "groupName": "Monitoring stack",
      "matchPackageNames": [
        "/prometheus/",
        "/grafana/",
        "/alertmanager/",
        "/loki/"
      ]
    },
    {
      "description": "Group Traefik updates",
      "groupName": "Traefik",
      "matchPackageNames": [
        "/traefik/"
      ]
    },
    {
      "description": "Require review for minor and patch updates",
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "reviewers": [
        "AKhozya"
      ],
      "assignees": [
        "AKhozya"
      ]
    },
    {
      "description": "Pin digests for Helm charts and images",
      "matchDatasources": [
        "helm",
        "docker"
      ],
      "pinDigests": false
    },
    {
      "description": "Require review for major updates",
      "matchUpdateTypes": [
        "major"
      ],
      "reviewers": [
        "AKhozya"
      ],
      "assignees": [
        "AKhozya"
      ],
      "minimumReleaseAge": "3 days"
    },
    {
      "description": "Percona images use X.Y.Z-A.B versioning (e.g. 8.4.7-7.1)",
      "matchPackageNames": [
        "percona/percona-server",
        "percona/percona-xtrabackup",
        "percona/percona-toolkit",
        "percona/percona-orchestrator"
      ],
      "versioning": "loose",
      "groupName": "Percona MySQL"
    },
    {
      "description": "Ignore MySQL backup image - manually updated with cluster",
      "matchPackageNames": ["mysql"],
      "matchFileNames": ["**/mysql-backup-cronjob.yaml"],
      "enabled": false
    },
    {
      "description": "Disable Docker detection for n8n - using custom GitHub releases manager",
      "matchPackageNames": ["n8nio/n8n"],
      "matchFileNames": ["**/n8n/**"],
      "matchDatasources": ["docker"],
      "enabled": false
    },
    {
      "description": "Ignore n8n pre-releases from GitHub releases datasource",
      "matchPackageNames": ["n8n-io/n8n"],
      "matchDatasources": ["github-releases"],
      "ignoreUnstable": true
    }
  ],
  "timezone": "Europe/London",
  "schedule": [
    "at any time"
  ],
  "ignorePaths": [
    "docs/**",
    "README.md",
    "clusters/**/flux-system/gotk-components.yaml"
  ]
}
